# ============================================
# LuxeCeramics 后端环境变量示例
# 复制为本文件为 .env 后修改（.env 已被 .gitignore 忽略）
# ============================================

# ---- 基本 ----
NODE_ENV=development
PORT=5000
API_PREFIX=/api

# ---- 数据库 MongoDB ----
# 本地开发默认 mongo 27017；生产改成 mongodb+srv://user:pwd@cluster...
MONGODB_URI=mongodb://127.0.0.1:27017/luxeceramics

# ---- JWT 鉴权（后台管理员登录） ----
JWT_SECRET=CHANGE_ME_luxeceramics_jwt_secret_32chars_xxxxxxxxxxxx
JWT_EXPIRES_IN=24h

# ---- 后台默认管理员（首次 seed 自动创建） ----
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin123

# ---- 站点基础信息 ----
SITE_NAME=LuxeCeramics
SITE_URL=http://localhost:5173
SALES_EMAIL=sales@luxeceramics.com

# ---- 邮件通知 (demo 模式为 console + 文件输出；生产填 SMTP 并在 email.ts 切换真实发送) ----
EMAIL_MODE=demo                  # demo | smtp
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="LuxeCeramics <noreply@luxeceramics.com>"
EMAIL_NOTIFY_TO=sales@luxeceramics.com,ops@luxeceramics.com

# ---- 文件上传 ----
UPLOAD_DIR=./public/uploads
UPLOAD_MAX_MB=10

# ============================================================
# 🔴 TRC20-USDT 真实链上收款配置（商户地址已由用户提供）
# ============================================================
# 链环境：开发=nile测试网；生产切 mainnet
TRON_NETWORK=nile

# TronGrid API Key（可选，不带也可免费调用；防止 429 建议去 trongrid.io 申请免费 key）
TRONGRID_API_KEY=

# 🔴 商户 Tron 钱包地址 base58（收款地址）
MERCHANT_WALLET_TRON=TC7TFRfTrhEk85dXeyfghM5hqFq9HRXabU

# TRC20 USDT 合约地址
# Nile 测试网合约: TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t（常作为 Nile USDT）
# Mainnet 主网合约: TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t（真实 USDT）
USDT_CONTRACT_NILE=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
USDT_CONTRACT_MAINNET=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# ---- 订单/支付参数 ----
ORDER_TTL_MINUTES=15               # 订单 15 分钟超时
USDT_TOLERANCE=0.01                # 金额容错 ±1%
REQUIRED_CONFIRMATIONS=6           # 最少区块确认数
USD_TO_USDT_RATE=1.0               # USD:USDT = 1:1 (陶瓷外贸基准)

# ---- 轮询 cron ----
# node-cron 表达式（秒 分 时 日 月 周）
CRON_AUTO_MATCH=*/30 * * * * *     # 每 30 秒：自动扫描 pending 订单到账
CRON_EXPIRE_SCAN=0 */1 * * * *     # 每分钟：扫描 expired 订单

# ---- 跨域 ----
CORS_ORIGIN=http://localhost:5173
