{
  "name": "luxeceramics-backend",
  "version": "1.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --exit-child -r tsconfig-paths/register src/index.ts",
    "build": "tsc -p . && echo 'backend build OK → dist/'",
    "start": "node dist/index.js",
    "start:prod": "node -r dotenv/config dist/index.js dotenv_config_path=./.env",
    "seed": "node dist/seed/seedData.js 2>/dev/null || ts-node -r tsconfig-paths/register src/seed/seedData.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "cron": "^3.5.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^7.2.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.3",
    "mongodb-memory-server": "^10.4.3",
    "mongoose": "^7.8.12",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/json2csv": "^5.0.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^6.4.24",
    "@types/qrcode": "^1.5.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  }
}
