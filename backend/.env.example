# ============================================
# 生产环境将 workspace/.env 复制/挂载到 backend/
# ============================================
NODE_ENV=development
PORT=5000
API_PREFIX=/api
MONGODB_URI=mongodb://127.0.0.1:27017/luxeceramics
JWT_SECRET=CHANGE_ME_luxeceramics_jwt_secret_32chars_xxxxxxxxxxxx
JWT_EXPIRES_IN=24h
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin123
SITE_NAME=LuxeCeramics
SITE_URL=http://localhost:5173
SALES_EMAIL=sales@luxeceramics.com
EMAIL_MODE=demo
EMAIL_NOTIFY_TO=sales@luxeceramics.com
UPLOAD_DIR=./public/uploads
UPLOAD_MAX_MB=10

# ===== 链上收款 =====
TRON_NETWORK=nile
TRONGRID_API_KEY=
MERCHANT_WALLET_TRON=TC7TFRfTrhEk85dXeyfghM5hqFq9HRXabU
USDT_CONTRACT_NILE=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
USDT_CONTRACT_MAINNET=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
ORDER_TTL_MINUTES=15
USDT_TOLERANCE=0.01
REQUIRED_CONFIRMATIONS=6
USD_TO_USDT_RATE=1.0
CRON_AUTO_MATCH=*/30 * * * * *
CRON_EXPIRE_SCAN=0 */1 * * * *
CORS_ORIGIN=http://localhost:5173

# ----- 启动行为 -----
# true=首次启动自动建 admin + 产品/案例等 mock 数据（幂等，已有则跳过）
RUN_SEED_ON_BOOT=true
# 后端默认托管前端 dist 做同源部署（SPA）；如果前后端分离部署，可改为不存在的路径以禁用
FRONTEND_DIST_PATH=../frontend/dist
