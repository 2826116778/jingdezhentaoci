# ============================================================================
# LuxeCeramics 后端环境变量模板
#
# 用法：
#   1. cp .env.example .env
#   2. 用 nano/vi 编辑 .env，把所有 [必填] 项改成生产值
#   3. 留空的项保持空即可（如未使用 SMTP）
#
# 标注说明：
#   [必填]        生产环境必须改成真实值，否则 deploy.sh 阶段 4 会拒绝继续
#   [生产改]      本地开发可保持默认，生产环境必须改
#   [可选]        可不改，按需配置
# ============================================================================

# ---------- 基础 ----------
NODE_ENV=production                    # [生产改] 生产用 production，开发用 development
PORT=5000                              # [可选] 后端监听端口
API_PREFIX=/api                        # [可选] API 路径前缀

# ---------- 数据库 ----------
# [必填] 本地开发用 mongodb://127.0.0.1:27017/luxeceramics
#        生产环境强烈推荐 MongoDB Atlas：mongodb+srv://用户名:密码@cluster0.xxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0&dbName=luxeceramics
#        注意：URL 末尾必须带 &dbName=luxeceramics，否则数据会写到默认 test 库
MONGODB_URI=mongodb://127.0.0.1:27017/luxeceramics

# ---------- 认证 ----------
# [必填] JWT 签名密钥，至少 32 字符
#        生成命令：openssl rand -hex 32
JWT_SECRET=CHANGE_ME_luxeceramics_jwt_secret_32chars_xxxxxxxxxxxx
JWT_EXPIRES_IN=24h                     # [可选] JWT 有效期

# ---------- 管理员初始账号 ----------
# [必填] 首次启动会自动创建此管理员，密码至少 12 位强密码
#        生成命令：openssl rand -base64 18
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin123

# ---------- 站点 ----------
SITE_NAME=LuxeCeramics                # [可选] 站点名称（邮件/页面标题）
SITE_URL=http://localhost:5173        # [生产改] 改成实际访问域名 https://你的域名.com
SALES_EMAIL=sales@luxeceramics.com    # [可选] 销售联系邮箱

# ---------- 邮件 ----------
# [可选] EMAIL_MODE=demo 时邮件只打印到控制台不发送
#        生产建议用 SMTP 中转（SendGrid / Mailgun / Amazon SES），避免被标垃圾
EMAIL_MODE=demo
EMAIL_NOTIFY_TO=sales@luxeceramics.com   # [可选] 新询盘/订单的通知收件人
SMTP_HOST=                             # [可选] 如 smtp.sendgrid.net
SMTP_PORT=465                          # [可选] 通常 465 (SSL) 或 587 (STARTTLS)
SMTP_SECURE=true                       # [可选] 465 用 true，587 用 false
SMTP_USER=                             # [可选] SMTP 用户名（SendGrid 用 apikey）
SMTP_PASS=                             # [可选] SMTP 密码/API Key
EMAIL_FROM="LuxeCeramics" <noreply@luxeceramics.com>   # [可选] 发件人

# ---------- 文件上传 ----------
UPLOAD_DIR=./public/uploads            # [可选] 上传根目录
UPLOAD_MAX_MB=10                       # [可选] 单文件大小上限 MB

# ============ Tron 链上收款（核心） ============
# [必填] 生产环境必须设为 mainnet，否则客户在主网付款会丢失！
TRON_NETWORK=nile

# [必填] TronGrid API Key，无 key 调主网 API 会被限流
#        免费申请：https://www.trongrid.io/register/
TRONGRID_API_KEY=

# [必填] 你的 USDT-TRC20 收款钱包地址（生产环境绝对不能用 demo 值！）
#        示例：TYourWalletAddress...
MERCHANT_WALLET_TRON=TC7TFRfTrhEk85dXeyfghM5hqFq9HRXabU

# USDT-TRC20 合约地址（默认值不用改，主网和 Nile 测试网都是同一个）
USDT_CONTRACT_NILE=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
USDT_CONTRACT_MAINNET=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# ---------- 订单支付参数 ----------
ORDER_TTL_MINUTES=15                   # [可选] 订单支付窗口（分钟），超时自动 expired
USDT_TOLERANCE=0.01                    # [可选] 金额容错比例（USDT），防精度误差导致支付失败
REQUIRED_CONFIRMATIONS=6               # [可选] 链上确认数门槛（主网建议 6+，更安全）
USD_TO_USDT_RATE=1.0                  # [可选] USD → USDT 汇率（1:1 时为 1.0）

# ---------- Cron 任务 ----------
CRON_AUTO_MATCH=*/30 * * * * *        # [可选] 自动扫描未确认订单匹配 txHash
CRON_EXPIRE_SCAN=0 */1 * * * *        # [可选] 扫描过期订单置 expired

# ---------- CORS ----------
# [可选] 允许的前端 origin（多个用逗号分隔）
#        生产部署建议改成实际域名：https://你的域名.com
CORS_ORIGIN=http://localhost:5173

# ---------- 启动行为 ----------
# [可选] true=首次启动自动 seed admin + 产品 + 案例（幂等，已有则跳过）
#        建议首次部署 true（自动初始化），稳定后改 false 避免每次重启都覆盖数据
RUN_SEED_ON_BOOT=true

# [可选] 后端默认托管 frontend/dist 做同源部署（SPA）；前后端分离部署可设不存在路径禁用
FRONTEND_DIST_PATH=../frontend/dist

# ============ AI 海外客户研究（PHASE 2-C，可选） ============
# [可选] 不使用 AI 功能时全部留默认即可
AI_PROVIDER=mock                       # mock=本地 mock 响应，openai=调用 OpenAI API
OPENAI_API_KEY=                        # [可选] AI_PROVIDER=openai 时必填
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=60000
AI_DAILY_REQUEST_LIMIT=200
AI_MONTHLY_REQUEST_LIMIT=3000
AI_PER_LEAD_DAILY_LIMIT=5
AI_CONCURRENCY=3
AI_MAX_RETRIES=3
